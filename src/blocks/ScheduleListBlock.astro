---
import BlockHead from '../components/content/BlockHead.astro';
import Scheduler from '../components/content/Scheduler.astro';

interface Props {
  id?: string;
  title: string;
  lede?: string;
  kelas?: 'D' | 'C' | 'B' | 'A';
  bulan?: string;
  chips?: boolean;
}

const {
  id = 'jadwal',
  title,
  lede,
  kelas,
  bulan,
  chips = true,
} = Astro.props;
const headingId = `${id}-title`;
---

<section class="block" id={id} aria-labelledby={headingId}>
  <BlockHead id={headingId} title={title} lede={lede} />
  <Scheduler kelas={kelas} bulan={bulan} chips={chips} />
</section>
