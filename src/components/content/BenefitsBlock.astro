---
import { benefits, blockCopy } from '../../config/blocks';
import BlockHead from './BlockHead.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../utils/icons';

interface BenefitItem {
  title: string;
  text: string;
  icon: IconName;
}

interface Props {
  title?: string;
  lede?: string;
  items?: readonly BenefitItem[];
}

const {
  title = blockCopy.benefitsTitle,
  lede = blockCopy.benefitsLede,
  items = benefits,
} = Astro.props;
---

<section class="block" id="fasilitas" aria-labelledby="fasilitas-title">
  <BlockHead id="fasilitas-title" title={title} lede={lede} />
  <ul class="benefit-grid">
    {
      items.map((benefit) => (
        <li class="benefit">
          <span class="benefit-icon">
            <Icon name={benefit.icon} size={30} />
          </span>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </li>
      ))
    }
  </ul>
</section>
