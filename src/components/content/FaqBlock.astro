---
import { faq, blockCopy } from '../../config/blocks';
import BlockHead from './BlockHead.astro';

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title?: string;
  lede?: string;
  items?: readonly FaqItem[];
}

const {
  title = blockCopy.faqTitle,
  lede = blockCopy.faqLede,
  items = faq,
} = Astro.props;
---

<section class="block" id="faq" aria-labelledby="faq-title">
  <BlockHead id="faq-title" title={title} lede={lede} />
  <div class="faq-list">
    {
      items.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>
            <h3>{item.q}</h3>
            <span class="faq-sign" aria-hidden="true" />
          </summary>
          <div class="faq-body">
            <p>{item.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>
