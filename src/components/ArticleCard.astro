---
/**
 * Kartu artikel — reusable untuk listing artikel.
 * Description berasal dari paragraf pertama (P1) dan tidak dipotong di sumber.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { slug, title, description, category, featuredImage, featuredImageAlt } = entry.data;
---

<article class="article-card">
  <a class="article-card__link" href={`/artikel/${slug}/`}>
    {featuredImage && (
      <img
        class="article-card__image"
        src={featuredImage}
        alt={featuredImageAlt ?? title}
        loading="lazy"
        width="640"
        height="576"
      />
    )}
    <div class="article-card__body">
      <span class="article-card__category">{category}</span>
      <h2 class="article-card__title">{title}</h2>
      <p class="article-card__description">{description}</p>
      <span class="article-card__read">Baca artikel <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
.article-card{display:flex;overflow:hidden;height:100%;border:1px solid var(--line,#eee);border-radius:var(--r-lg,16px);background:#fff;transition:transform .2s ease,box-shadow .2s ease}
.article-card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgb(0 0 0 / .08)}
.article-card__link{display:flex;width:100%;height:100%;flex-direction:column;color:inherit;text-decoration:none}
.article-card__image{display:block;width:100%;aspect-ratio:1.11;object-fit:cover;background:var(--soft,#fff2f1)}
.article-card__body{display:flex;flex:1;flex-direction:column;padding:1.2rem}
.article-card__category{color:var(--black,#dc1e1e);font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
.article-card__title{margin:.55rem 0;font-size:1.12rem;line-height:1.4;color:var(--ink,#111)}
.article-card__description{display:-webkit-box;overflow:hidden;margin:0 0 1rem;color:var(--mute,#555);font-size:.9rem;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:5}
.article-card__read{margin-top:auto;color:var(--black,#dc1e1e);font-size:.85rem;font-weight:700}
@media(prefers-reduced-motion:reduce){.article-card{transition:none}.article-card:hover{transform:none}}
</style>
