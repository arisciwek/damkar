---
import '../styles/global.css';
import { photos, site } from '../config/site';
import { ui } from '../config/ui';
import { absolute, serializeJsonLd, type JsonLd } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  /** Canonical halaman; default mengikuti URL yang dirender. */
  canonical?: string;
  noindex?: boolean;
  /** Gambar sosial (og:image). Path lokal dikonversi ke URL absolut. */
  image?: string;
  imageAlt?: string;
  /** <link rel="preload"> untuk foto hero (WebP dipakai <img>, bukan og:image). */
  preloadImage?: string;
  pubDate?: Date;
  updatedDate?: Date;
  /** Node schema.org tambahan untuk halaman ini. */
  jsonLd?: JsonLd[];
  bodyClass?: string;
}

const {
  title = ui.meta.defaultTitle,
  description = ui.meta.defaultDescription,
  canonical,
  noindex = false,
  image = ui.meta.defaultImage,
  imageAlt = ui.meta.defaultImageAlt,
  jsonLd = [],
} = Astro.props;

const siteUrl = (Astro.site?.toString() ?? site.url).replace(/\/$/, '');
const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).toString()
  : new URL(Astro.url.pathname, siteUrl).toString();

const preloadImage = Astro.props.preloadImage;

const imageUrl = absolute(image);
const isRaster = /\.(png|jpe?g|webp|gif)$/i.test(imageUrl.split(/[?#]/)[0]);
const socialImage = isRaster ? imageUrl : absolute(photos[0].ogSrc);
const socialImageAlt = isRaster ? imageAlt : ui.meta.defaultImageAlt;

// Dimensi og:image diambil dari data foto supaya cocok walau halaman memakai foto lain.
const matchedPhoto = photos.find(
  (photo) =>
    photo.src === image ||
    photo.ogSrc === image ||
    absolute(photo.src) === socialImage ||
    absolute(photo.ogSrc) === socialImage,
);
const imageDims = matchedPhoto
  ? { width: String(matchedPhoto.w), height: String(matchedPhoto.h) }
  : undefined;

// Preload foto hero (versi WebP), bukan file og:image.
const preloadHref = preloadImage ?? matchedPhoto?.src;
const jsonLdHtml = serializeJsonLd(jsonLd);
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : ui.meta.robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="id-ID" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta name="author" content={ui.meta.author} />
    <meta name="theme-color" content={ui.meta.themeColor} />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />
    {preloadHref && <link rel="preload" as="image" href={preloadHref} fetchpriority="high" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    {imageDims && (
      <>
        <meta property="og:image:width" content={imageDims.width} />
        <meta property="og:image:height" content={imageDims.height} />
      </>
    )}
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" type="image/png" href="/images/logo-betracom.png" />
    <link rel="apple-touch-icon" href="/images/logo-betracom.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {jsonLd.length > 0 && (
      <script type="application/ld+json" is:inline set:html={jsonLdHtml}></script>
    )}
  </head>
  <body class={Astro.props.bodyClass}>
    <a class="skip-link" href="#konten">Langsung ke konten utama</a>
    <slot />
  </body>
</html>