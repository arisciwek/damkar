---
import { blockRegistry } from './registry';
import type { BlockConfig } from './types';

interface Props {
  blocks: BlockConfig[];
}

const { blocks } = Astro.props;

function propsFor(block: BlockConfig): Record<string, unknown> {
  switch (block.type) {
    case 'hero':
      return {
        eyebrow: block.eyebrow,
        heading: block.heading,
        highlight: block.highlight,
        lead: block.lead,
        breadcrumb: block.breadcrumb,
        nearest: block.nearest,
        facts: block.facts,
        actions: block.actions,
        media: block.media,
      };
    case 'other-programs':
      return { title: block.title, lede: block.lede, items: block.items };
    case 'class-detail':
      return {
        name: block.name,
        role: block.role,
        description: block.description,
        mode: block.mode,
        modeNote: block.modeNote,
        step: block.step,
        materi: block.materi,
        requirement: block.requirement,
        location: block.location,
        photos: block.photos,
      };
    case 'reasons':
      return {
        title: block.title,
        lede: block.lede,
        intro: block.intro,
        items: block.items,
      };
    case 'benefits':
    case 'faq':
    case 'gallery':
    case 'program-grid':
    case 'class-tabs':
      return { title: block.title, lede: block.lede, items: 'items' in block ? block.items : undefined };
    case 'nearest-schedule':
      return { kelas: block.kelas, limit: block.limit };
    case 'schedule-list':
      return {
        id: block.id,
        title: block.title,
        lede: block.lede,
        kelas: block.kelas,
        bulan: block.bulan,
        chips: block.chips,
      };
    case 'contact-band':
      return { id: block.id, heading: block.heading, kicker: block.kicker };
  }
}
---

{blocks.map((block) => {
  // Component Astro bertipe berbeda-beda; kontrak props sudah dinarrow oleh propsFor().
  const Component = blockRegistry[block.type] as any;
  return <Component {...propsFor(block)} />;
})}
