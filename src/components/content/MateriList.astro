---
interface Props {
  items: string[];
  /** Jumlah materi yang tampil sebelum "tampilkan lebih banyak". */
  limit?: number;
}

const { items, limit = 7 } = Astro.props;
const overflow = items.length > limit;
---

<ol class="materi">
  {
    items.map((materi, index) => (
      <li class={index >= limit ? 'more' : undefined}>{materi}</li>
    ))
  }
</ol>
{
  overflow && (
    <button class="more-btn" type="button" aria-expanded="false" data-more>
      Lihat semua {items.length} materi
    </button>
  )
}

<script>
  // "Lihat semua materi" — sama perilakunya dengan main.js pada situs referensi.
  // <script> Astro adalah modul: dieksekusi satu kali per halaman.
  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-more]');
    if (!btn) return;
    const list = btn.previousElementSibling as HTMLOListElement;
    const open = btn.getAttribute('aria-expanded') !== 'true';
    list.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open
      ? 'Tampilkan lebih sedikit'
      : `Lihat semua ${list.children.length} materi`;
  });
</script>