---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBlockRenderer from '../../blocks/PageBlockRenderer.astro';
import type { PageBlockConfig } from '../../blocks/types';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import WaFloat from '../../components/shared/WaFloat.astro';
import { photos } from '../../config/site';
import { ui } from '../../config/ui';
import {
  breadcrumbNode,
  faqPageNode,
  organizationNode,
  programItemList,
  websiteNode,
  webpageNode,
} from '../../utils/schema';

const page = await getEntry('pages', 'layanan');
if (!page) throw new Error('Konten halaman layanan (src/content/pages/layanan.md) tidak ditemukan.');

const blocks = page.data.blocks as unknown as PageBlockConfig[];
const contentLayout = blocks.find(
  (block): block is Extract<PageBlockConfig, { type: 'content-layout' }> =>
    block.type === 'content-layout',
);
const faqBlock = contentLayout?.blocks.find((block) => block.type === 'faq');

const title = page.data.title;
const description = page.data.description ?? ui.meta.defaultDescription;
const url = new URL('/layanan/', Astro.site).toString();

const kelasItems = (await getCollection('kelas', (entry) => !entry.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    url: new URL(`/layanan/${entry.id}/`, Astro.site).toString(),
    name: `Pelatihan ${entry.data.name}`,
  }));

const jsonLd = [
  organizationNode(),
  websiteNode(),
  webpageNode({
    url,
    name: title,
    description,
    extra: { mainEntity: { '@id': `${url}#program` } },
  }),
  breadcrumbNode(url, [
    { name: ui.nav.breadcrumbHome, url: new URL('/', Astro.site).toString() },
    { name: 'Layanan', url },
  ]),
  programItemList(kelasItems, `${url}#program`),
  faqPageNode(
    url,
    faqBlock?.type === 'faq' ? (faqBlock.items ?? []).map((item) => ({ q: item.q, a: item.a })) : [],
  ),
];
---

<BaseLayout title={title} description={description} preloadImage={photos[0].src} jsonLd={jsonLd}>
  <SiteHeader />
  <main id="konten">
    <PageBlockRenderer blocks={blocks} />
  </main>
  <SiteFooter />
  <WaFloat />
</BaseLayout>
