---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBlockRenderer from '../../blocks/PageBlockRenderer.astro';
import type { PageBlockConfig } from '../../blocks/types';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import WaFloat from '../../components/shared/WaFloat.astro';
import { countBatches } from '../../utils/schedule';
import { photos, site, waDaftar } from '../../config/site';
import { ui } from '../../config/ui';
import {
  breadcrumbNode,
  organizationNode,
  scheduleItemList,
  webpageNode,
  websiteNode,
} from '../../utils/schema';

const page = await getEntry('pages', 'jadwal');
if (!page) throw new Error('Konten halaman jadwal (src/content/pages/jadwal.md) tidak ditemukan.');

const totalBatches = await countBatches();
const title = page.data.title
  .replaceAll('{{year}}', String(site.year))
  .replaceAll('{{count}}', String(totalBatches));
const description = (page.data.description ?? ui.meta.defaultDescription)
  .replaceAll('{{year}}', String(site.year))
  .replaceAll('{{count}}', String(totalBatches));
const url = new URL('/jadwal/', Astro.site).toString();
const ctaMsg =
  'Halo tim Betracom, saya ingin mendaftar Pelatihan Damkar. Mohon info jadwal, biaya, dan persyaratannya.';

const sourceBlocks = page.data.blocks as unknown as PageBlockConfig[];
const blocks = sourceBlocks.map((block) => {
  if (block.type !== 'hero') return block;

  return {
    ...block,
    highlight: `${site.year}.`,
    lead: `Semua gelombang Public Training bersertifikat Kemnaker RI dalam satu halaman — ${totalBatches} gelombang sepanjang ${site.year} untuk Kelas D, C, B, dan A. Pilih kelas dan bulan, lalu daftar via WhatsApp.`,
    facts: block.facts.map((fact) =>
      fact.label.startsWith('Gelombang')
        ? { ...fact, value: String(totalBatches), label: `Gelombang ${site.year}` }
        : fact,
    ),
    actions: block.actions.map((action) =>
      action.label === 'Daftar Sekarang'
        ? { ...action, href: waDaftar(ctaMsg) }
        : action,
    ),
  };
}) as PageBlockConfig[];

// ItemList: 4 halaman jadwal per kelas (anak dari halaman ini).
const kelasItems = (await getCollection('trainings', (entry) => !entry.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    url: new URL(`/jadwal/kelas-${entry.data.key.toLowerCase()}/`, Astro.site).toString(),
    name: `Jadwal ${entry.data.name}`,
  }));

const jsonLd = [
  organizationNode(),
  websiteNode(),
  webpageNode({
    url,
    name: title,
    description,
  }),
  breadcrumbNode(url, [
    { name: ui.nav.breadcrumbHome, url: new URL('/', Astro.site).toString() },
    { name: 'Jadwal', url },
  ]),
  scheduleItemList(url, `Halaman jadwal per kelas ${site.year}`, kelasItems),
];
---

<BaseLayout title={title} description={description} preloadImage={photos[0].src} jsonLd={jsonLd}>
  <SiteHeader />
  <main id="konten">
    <PageBlockRenderer blocks={blocks} />
  </main>
  <SiteFooter />
  <WaFloat />
</BaseLayout>
