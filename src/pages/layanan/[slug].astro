---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBlockRenderer from '../../blocks/PageBlockRenderer.astro';
import type { PageBlockConfig } from '../../blocks/types';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import WaFloat from '../../components/shared/WaFloat.astro';
import { faq } from '../../config/blocks';
import { active, batches, countBatches, type KelasKey } from '../../config/jadwal';
import { organization, photos, site } from '../../config/site';
import { ui } from '../../config/ui';
import {
  breadcrumbNode,
  courseNode,
  faqPageNode,
  organizationNode,
  websiteNode,
  webpageNode,
} from '../../utils/schema';

export async function getStaticPaths() {
  const entries = (await getCollection('kelas', (entry) => !entry.data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, entries },
  }));
}

const { entry, entries } = Astro.props;
const page = await getEntry('pages', entry.id);
if (!page) throw new Error(`Markdown blocks untuk halaman ${entry.id} tidak ditemukan.`);

const data = entry.data;
const key = data.key as KelasKey;
if (page.data.kelas !== key) {
  throw new Error(`Referensi kelas pada ${entry.id} tidak cocok dengan collection kelas ${key}.`);
}
const step = (['D', 'C', 'B', 'A'] as KelasKey[]).indexOf(key);
const photo = photos[step];
const url = new URL(`/layanan/${entry.id}/`, Astro.site).toString();
const title = page.data.title;
const description = `Pelatihan ${data.name} (${data.role}) sertifikasi Kemnaker RI. ${data.mode}, pendidikan minimal ${data.education}, ${data.materi.length} materi. Cek jadwal ${site.year} di sini.`;
const ctaMsg = `Halo tim Betracom, saya ingin mendaftar Pelatihan ${data.name}. Mohon info jadwal, biaya, dan persyaratannya.`;
const gelombangCount = countBatches(key);
const gelombangAktif = active(key).length;
const lokasi = faq[3].a;
const zigPhotos = [photos[(step + 1) % 4], photos[(step + 2) % 4], photos[(step + 3) % 4]];

const blocks = page.data.blocks.map((pageBlock: any) => {
  if (pageBlock.type !== 'content-layout') {
    if (pageBlock.type === 'hero') {
      return {
        ...pageBlock,
        heading: `Pelatihan ${data.name}`,
        highlight: data.role,
        lead: `${data.desc} Program ${data.mode} dengan sertifikasi Kemnaker RI bersama ${organization.name}.`,
        breadcrumb: [
          { label: ui.nav.breadcrumbHome, href: '/' },
          { label: 'Program', href: '/layanan/' },
          { label: data.name },
        ],
        nearest: { kelas: key, limit: 2 },
        facts: pageBlock.facts.map((fact: any) => ({
          ...fact,
          dynamic: undefined,
          value: fact.label === 'Materi' ? String(data.materi.length)
            : fact.label.startsWith('Gelombang') ? String(gelombangCount)
            : fact.label.startsWith('Pendidikan') ? data.education
            : fact.value,
        })),
        actions: pageBlock.actions.map((action: any) =>
          action.label === 'Daftar Sekarang'
            ? { ...action, href: `https://wa.me/6282268066126?text=${encodeURIComponent(ctaMsg)}` }
            : action,
        ),
        media: { type: 'photo', photo, letter: key },
      };
    }
    if (pageBlock.type === 'contact-band') return pageBlock;
    return pageBlock;
  }

  return {
    ...pageBlock,
    ctaMsg,
    blocks: pageBlock.blocks.map((block: any) => {
      if (block.type === 'reasons') return { ...block, title: `Mengapa ${data.name} Penting?` };
      if (block.type === 'class-detail') return {
        type: 'class-detail',
        name: data.name,
        role: data.role,
        description: data.desc,
        mode: data.mode,
        modeNote: data.modeNote,
        step: data.step,
        materi: [...data.materi],
        requirement: data.requirement,
        location: lokasi,
        photos: zigPhotos,
      };
      if (block.type === 'schedule-list') return {
        ...block,
        title: `Jadwal ${data.name} ${site.year}`,
        lede: `${gelombangCount} gelombang Public Training sepanjang ${site.year}, ${gelombangAktif} di antaranya masih aktif atau akan datang.`,
        kelas: key,
        chips: false,
      };
      if (block.type === 'other-programs') return {
        ...block,
        items: entries
          .filter((other: any) => other.data.key !== key)
          .map((other: any) => ({
            key: other.data.key,
            step: other.data.step,
            name: other.data.name,
            role: other.data.role,
            href: `/layanan/${other.id}/`,
          })),
      };
      return block;
    }),
  };
}) as PageBlockConfig[];

const scheduleForSchema = batches
  .filter((batch) => batch.class === key)
  .map((batch) => ({
    class: batch.class,
    batch: batch.batch,
    start: batch.start,
    end: batch.end,
    label: batch.label,
  }));

const jsonLd = [
  organizationNode(),
  websiteNode(),
  webpageNode({
    url,
    name: title,
    description,
    extra: { about: { '@id': `${url}#course` }, breadcrumb: { '@id': `${url}#breadcrumb` } },
  }),
  breadcrumbNode(url, [
    { name: ui.nav.breadcrumbHome, url: new URL('/', Astro.site).toString() },
    { name: `Pelatihan ${data.name}`, url },
  ]),
  courseNode({
    key,
    slug: entry.id,
    name: data.name,
    role: data.role,
    desc: data.desc,
    mode: data.mode,
    courseMode: data.courseMode,
    education: data.education,
    materi: [...data.materi],
    schedule: scheduleForSchema,
  }),
  faqPageNode(url, faq.map((item) => ({ q: item.q, a: item.a }))),
];
---

<BaseLayout
  title={title}
  description={description}
  image={photo.ogSrc}
  imageAlt={photo.alt}
  preloadImage={photo.src}
  jsonLd={jsonLd}
>
  <SiteHeader />
  <main id="konten">
    <PageBlockRenderer blocks={blocks} />
  </main>
  <SiteFooter />
  <WaFloat />
</BaseLayout>
