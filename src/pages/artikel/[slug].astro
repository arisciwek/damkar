---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBlockRenderer from '../../blocks/ArticleBlockRenderer.astro';
import Hero from '../../components/content/Hero.astro';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import WaFloat from '../../components/shared/WaFloat.astro';
import { absolute, breadcrumbNode, organizationNode, websiteNode, webpageNode } from '../../utils/schema';

export async function getStaticPaths() {
  const entries = await getCollection('articles', (entry) => !entry.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const article = entry.data;
const url = new URL(`/artikel/${article.slug}/`, Astro.site).toString();
const published = article.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
const updated = article.updatedDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
const author = {
  '@type': article.author.type,
  name: article.author.name,
  ...(article.author.url ? { url: article.author.url } : {}),
};
const articleNode = {
  '@type': article.schemaType,
  '@id': `${url}#article`,
  mainEntityOfPage: { '@id': `${url}#webpage` },
  headline: article.title,
  description: article.description,
  image: article.featuredImage ? absolute(article.featuredImage) : undefined,
  datePublished: article.pubDate.toISOString(),
  dateModified: article.updatedDate.toISOString(),
  author,
  publisher: { '@id': `${new URL('/', Astro.site).toString().replace(/\/$/, '')}#organization` },
  articleSection: article.category,
  keywords: article.tags,
  inLanguage: 'id-ID',
};
// P1 tetap berasal dari blocks[]: ditampilkan pada hero dan tidak diulang di badan.
let lead: string | null = null;
let bodyBlocks = article.blocks;
const firstSection = article.blocks.find((b) => b.component === 'section');
if (firstSection?.component === 'section') {
  const firstP = firstSection.content.find((c) => c.type === 'p');
  if (firstP?.type === 'p') {
    lead = firstP.text;
    bodyBlocks = article.blocks.map((b) =>
      b === firstSection && b.component === 'section'
        ? { ...b, content: b.content.filter((c) => c !== firstP) }
        : b,
    );
  }
}

const jsonLd = [
  organizationNode(),
  websiteNode(),
  webpageNode({ url, name: article.title, description: article.description, extra: { mainEntity: { '@id': `${url}#article` }, breadcrumb: { '@id': `${url}#breadcrumb` } } }),
  breadcrumbNode(url, [
    { name: 'Beranda', url: new URL('/', Astro.site).toString() },
    { name: 'Artikel', url: new URL('/artikel/', Astro.site).toString() },
    { name: article.title, url },
  ]),
  articleNode,
];
---

<BaseLayout
  title={article.title}
  description={article.description}
  canonical={url}
  image={article.featuredImage}
  imageAlt={article.featuredImageAlt ?? article.title}
  ogType="article"
  publishedTime={article.pubDate}
  modifiedTime={article.updatedDate}
  jsonLd={jsonLd}
>
  <SiteHeader />
  <main id="konten" class="article-page">
    <Hero eyebrow={article.category} heading={article.title} lead={lead ?? article.description}>
      <nav slot="crumbs" class="article-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a><span aria-hidden="true">›</span>
        <a href="/artikel/">Artikel</a><span aria-hidden="true">›</span>
        <span aria-current="page">{article.title}</span>
      </nav>
      <div slot="near" class="article-hero-meta">
        <span>{article.author.name}</span>
        <time datetime={article.pubDate.toISOString()}>{published}</time>
        {article.updatedDate > article.pubDate && <span>Diperbarui {updated}</span>}
      </div>
      {article.featuredImage && (
        <figure slot="media" class="hero-photo article-hero-photo">
          <img
            src={article.featuredImage}
            width="1184"
            height="1066"
            alt={article.featuredImageAlt ?? article.title}
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}
    </Hero>

    <div class="container article-page__container">
      <article class="article-document">
        <ArticleBlockRenderer blocks={bodyBlocks} />
        <footer class="article-footer">
          <p class="article-footer__label">Topik artikel</p>
          <ul class="article-tags">{article.tags.map((tag: string) => <li>{tag}</li>)}</ul>
          <a class="article-footer__back" href="/artikel/">← Kembali ke semua artikel</a>
        </footer>
      </article>
    </div>
  </main>
  <SiteFooter />
  <WaFloat />
</BaseLayout>

<style>
.article-page{padding-bottom:4rem}
.article-breadcrumb{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center;margin:0 0 1.6rem;color:var(--mute,#666);font-size:.82rem;line-height:1.6}
.article-breadcrumb a{color:var(--black,#dc1e1e);text-decoration:none}
.article-breadcrumb [aria-current="page"]{overflow-wrap:anywhere}
.article-hero-meta{display:flex;flex-wrap:wrap;gap:.45rem 1rem;margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--line,#eee);font-size:.82rem;color:var(--mute,#666)}
.article-hero-photo{overflow:hidden;border-radius:var(--r-lg,16px);background:var(--soft,#fff2f1)}
.article-hero-photo img{display:block;width:100%;height:100%;max-height:532px;aspect-ratio:1.11;object-fit:cover}
.article-page__container{max-width:920px}
.article-document{max-width:780px;margin-inline:auto}
.article-footer{margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--line,#eee)}
.article-footer__label{font-size:.8rem;font-weight:700;color:var(--mute,#666)}
.article-tags{display:flex;flex-wrap:wrap;gap:.5rem;margin:0;padding:0;list-style:none}
.article-tags li{padding:.35rem .65rem;border-radius:999px;background:var(--soft,#fff2f1);font-size:.78rem;color:var(--text,#333)}
.article-footer__back{display:inline-block;margin-top:1.5rem;color:var(--black,#dc1e1e);font-weight:600;text-decoration:none}
@media(max-width:767px){.article-hero-meta{margin-top:1rem}.article-hero-photo img{max-height:420px}}
</style>
