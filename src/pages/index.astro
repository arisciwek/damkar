---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBlockRenderer from '../blocks/PageBlockRenderer.astro';
import type { PageBlockConfig } from '../blocks/types';
import SiteFooter from '../components/shared/SiteFooter.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import WaFloat from '../components/shared/WaFloat.astro';
import { site, photos } from '../config/site';
import { ui } from '../config/ui';
import {
  faqPageNode,
  ids,
  organizationNode,
  programItemList,
  webpageNode,
  websiteNode,
} from '../utils/schema';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Konten halaman beranda (src/content/pages/home.md) tidak ditemukan.');

const blocks = page.data.blocks as unknown as PageBlockConfig[];
const faqBlock = blocks
  .filter((block): block is Extract<PageBlockConfig, { type: 'content-layout' }> => block.type === 'content-layout')
  .flatMap((layout) => layout.blocks)
  .find((block) => block.type === 'faq');

const title = page.data.title;
const description = page.data.description ?? ui.meta.defaultDescription;
const url = new URL('/', Astro.site).toString();

const kelasItems = (await getCollection('kelas', (entry) => !entry.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    url: new URL(`/layanan/${entry.id}/`, Astro.site).toString(),
    name: `Pelatihan ${entry.data.name}`,
  }));

const jsonLd = [
  organizationNode(),
  websiteNode(),
  webpageNode({
    url,
    name: title,
    description,
    extra: { about: { '@id': ids.org }, mainEntity: { '@id': `${url}#program` } },
  }),
  programItemList(kelasItems, `${url}#program`),
  faqPageNode(
    url,
    faqBlock?.type === 'faq' ? (faqBlock.items ?? []).map((item) => ({ q: item.q, a: item.a })) : [],
  ),
];
---

<BaseLayout title={title} description={description} preloadImage={photos[0].src} jsonLd={jsonLd}>
  <SiteHeader />
  <main id="konten">
    <PageBlockRenderer blocks={blocks} />
  </main>
  <SiteFooter />
  <WaFloat />
</BaseLayout>
