---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockHead from '../components/content/BlockHead.astro';
import BenefitsBlock from '../components/content/BenefitsBlock.astro';
import DetailTabs from '../components/content/DetailTabs.astro';
import FaqBlock from '../components/content/FaqBlock.astro';
import GalleryBlock from '../components/content/GalleryBlock.astro';
import Hero from '../components/content/Hero.astro';
import HeroSlider from '../components/content/HeroSlider.astro';
import Nearest from '../components/content/Nearest.astro';
import ProgramGrid from '../components/content/ProgramGrid.astro';
import ReasonsBlock from '../components/content/ReasonsBlock.astro';
import Scheduler from '../components/content/Scheduler.astro';
import Sidebar from '../components/content/Sidebar.astro';
import ContactBand from '../components/shared/ContactBand.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import WaFloat from '../components/shared/WaFloat.astro';
import { faq } from '../config/blocks';
import { countBatches } from '../config/jadwal';
import { photos, site, waDaftar } from '../config/site';
import { ui } from '../config/ui';
import {
  faqPageNode,
  ids,
  organizationNode,
  programItemList,
  webpageNode,
  websiteNode,
} from '../utils/schema';

const title = ui.meta.defaultTitle;
const description = ui.meta.defaultDescription;
const url = new URL('/', Astro.site).toString();

// Hero actions — pesan WA home = persis referensi ("konsultasi", bukan "mendaftar").
const heroCta = 'Halo saya ingin konsultasi Pelatihan Damkar.';
const sideCta = 'Halo saya ingin mendaftar Pelatihan Damkar.';

const kelasItems = (await getCollection('kelas', (entry) => !entry.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    url: new URL(`/layanan/${entry.id}/`, Astro.site).toString(),
    name: `Pelatihan ${entry.data.name}`,
  }));

const jsonLd = [
  organizationNode(),
  websiteNode(),
  webpageNode({
    url,
    name: title,
    description,
    extra: { about: { '@id': ids.org }, mainEntity: { '@id': `${url}#program` } },
  }),
  programItemList(kelasItems, `${url}#program`),
  faqPageNode(
    url,
    faq.map((item) => ({ q: item.q, a: item.a })),
  ),
];
---

<BaseLayout title={title} description={description} preloadImage={photos[0].src} jsonLd={jsonLd}>
  <SiteHeader />
  <main id="konten">
    <Hero
      eyebrow="Sertifikasi Kemnaker RI"
      heading="Pelatihan Damkar Kelas D, C, B & A"
      highlight="Kompetensi untuk keselamatan."
      lead="Pelatihan Pemadam Kebakaran Kelas D, C, B & A untuk membangun kompetensi pencegahan, penanggulangan, dan evaluasi sistem proteksi kebakaran di tempat kerja."
    >
      <Nearest slot="near" limit={3} />
      <ul class="hero-facts" slot="facts">
        <li><b>4</b>Jenjang kompetensi</li>
        <li><b>{countBatches()}</b>Gelombang {site.year}</li>
        <li><b>Kemnaker</b>Sertifikasi & lisensi resmi</li>
      </ul>
      <div class="actions" slot="actions">
        <a class="btn btn-black btn-lg" href={waDaftar(heroCta)} target="_blank" rel="noopener">
          Daftar Sekarang
        </a>
        <a class="btn btn-outline btn-lg" href="#jadwal">Lihat Jadwal</a>
      </div>
      <HeroSlider slot="media" />
    </Hero>

    <div class="container layout">
      <Sidebar
        ctaMsg={sideCta}
        links={[
          { id: 'manfaat', label: 'Manfaat Pelatihan', icon: 'check' },
          { id: 'program', label: 'Jenjang Program', icon: 'list' },
          { id: 'detail', label: 'Materi Pelatihan', icon: 'book' },
          { id: 'fasilitas', label: 'Mengapa Pilih Kami', icon: 'badge' },
          { id: 'pengalaman', label: 'Praktik Lapangan', icon: 'flame' },
          { id: 'jadwal', label: 'Jadwal & Persyaratan', icon: 'cal' },
          { id: 'faq', label: 'FAQ', icon: 'info' },
        ]}
      />
      <div class="content">
        <ReasonsBlock title="Mengapa Pelatihan Damkar Penting?" />
        <ProgramGrid />
        <DetailTabs />
        <BenefitsBlock />
        <GalleryBlock />

        <section class="block" id="jadwal" aria-labelledby="jadwal-title">
          <BlockHead
            id="jadwal-title"
            title={`Jadwal Pelatihan Damkar ${site.year}`}
            lede="Temukan tanggal yang cocok. Pilih kelas dan bulan, lalu daftar langsung via WhatsApp."
          />
          <Scheduler />
        </section>

        <FaqBlock />
      </div>
    </div>

    <ContactBand />
  </main>
  <SiteFooter />
  <WaFloat />
</BaseLayout>
