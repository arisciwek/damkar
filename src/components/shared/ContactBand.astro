---
import { organization } from '../../config/site';
import { ui } from '../../config/ui';

interface Props {
  /** Id section dipakai target anchor dari sidebar/navigasi. */
  id?: string;
  heading?: string;
  kicker?: string;
}

const { id = 'kontak', heading = ui.contact.heading, kicker = ui.contact.kicker } = Astro.props;
---

<section class="contact" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="contact-top">
      <div>
        <p class="contact-kicker">{kicker}</p>
        <h2 id={`${id}-title`}>{heading}</h2>
      </div>
      <a class="btn btn-white btn-lg" href={ui.contact.whatsappHref} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.9-.9L3 20l1.1-4.6A8.4 8.4 0 0 1 3 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5z"/></svg>
        {ui.contact.whatsappLabel}
      </a>
    </div>
    <div class="contact-grid">
      <div>
        <p class="contact-label">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          {ui.contact.labels.phone}
        </p>
        <p class="contact-val">
          {organization.phones.map((phone) => (
            <a href={`tel:${phone.tel}`}>{phone.display}</a>
          ))}
        </p>
      </div>
      <div>
        <p class="contact-label">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          {ui.contact.labels.email}
        </p>
        <p class="contact-val"><a href={`mailto:${organization.email}`}>{organization.email}</a></p>
      </div>
      <div>
        <p class="contact-label">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {ui.contact.labels.office}
        </p>
        <p class="contact-val">
          {organization.address.street}<br />
          {organization.address.road}, {organization.address.city}
        </p>
      </div>
      <div>
        <p class="contact-label">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.5 13 17 22l-5-3-5 3 1.5-9"/></svg>
          {ui.contact.labels.certificate}
        </p>
        <p class="contact-val">
          {ui.contact.certificateValue}<br /><span>{ui.contact.certificateNote}</span>
        </p>
      </div>
    </div>
  </div>
</section>